{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/app-support/layout,_N_T_/app-support/page,_N_T_/app-support"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/app-support/__PAGE__",
    "/app-support",
    "/_index",
    "/_head"
  ]
}